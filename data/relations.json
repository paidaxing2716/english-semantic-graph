      "note": "exclude（关在外）+ -ive（倾向于…的）→ 惯于把别人关在外面的 → 独家的、排他的"
    },
    {
      "from": "clud",
      "to": "seclude",
      "type": "root",
      "note": "se-（分开）+ clud（关闭）→ 单独关起来 → 隔离、隐居"
    },
    {
      "from": "tain",
      "to": "contain",
      "type": "root",
      "note": "con-（一起）+ tain（握住）→ 把东西一起握在里面 → 容纳、控制住"
    },
    {
      "from": "tain",
      "to": "obtain",
      "type": "root",
      "note": "ob-（朝向、对着）+ tain（握住）→ 伸手够到并握住 → 获得"
    },
    {
      "from": "tain",
      "to": "retain",
      "type": "root",
      "note": "re-（往回、持续）+ tain（握住）→ 一直握着不放 → 保留"
    },
    {
      "from": "tain",
      "to": "detain",
      "type": "root",
      "note": "de-（离开原路）+ tain（握住）→ 把人从原本要去的路上握住 → 扣留、耽误"
    },
    {
      "from": "tain",
      "to": "sustain",
      "type": "root",
      "note": "sus-（sub- 的变体，从下面）+ tain（握住）→ 从底下托住不让塌 → 维持"
    },
    {
      "from": "clud",
      "to": "preclude",
      "type": "root",
      "note": "pre-（在…之前）+ clud（关闭）→ 事情发生前先把门关上 → 预先排除"
    },
    {
      "from": "clud",
      "to": "inclusive",
      "type": "root",
      "note": "include（关在内）+ -ive（倾向于…的）→ 惯于把人一起关在内的 → 包容的、含…在内的"
    },
    {
      "from": "fac",
      "to": "affect",
      "type": "root",
      "note": "af-（ad- 的变体，朝向）+ fect（fac 的变体，做）→ 对某物做点什么，使它起变化 → 影响"
    },
    {
      "from": "fac",
      "to": "effect",
      "type": "root",
      "note": "ef-（ex- 的变体，向外）+ fect（做）→ 做出来、显出来的那个结果 → 效果"
    },
    {
      "from": "fac",
      "to": "effective",
      "type": "root",
      "note": "effect（做出结果）+ -ive（能…的）→ 真能做出结果的 → 有效的"
    },
    {
      "from": "fac",
      "to": "defect",
      "type": "root",
      "note": "de-（缺、离）+ fect（做）→ 该做的地方没做到 → 缺陷"
    },
    {
      "from": "fac",
      "to": "perfect",
      "type": "root",
      "note": "per-（彻底、全部）+ fect（做）→ 从头到尾全做到了 → 完美的"
    },
    {
      "from": "fac",
      "to": "infect",
      "type": "root",
      "note": "in-（进入）+ fect（做）→ 在体内做起手脚 → 感染"
    },
    {
      "from": "fac",
      "to": "efficient",
      "type": "root",
      "note": "ef-（向外）+ fic（fac 的变体，做）+ -ient → 能把事做出来且不浪费的 → 高效的"
    },
    {
      "from": "fac",
      "to": "sufficient",
      "type": "root",
      "note": "suf-（sub- 的变体，从下面）+ fic（做）+ -ient → 在底下垫够了、够用来做成事的 → 足够的"
    },
    {
      "from": "tend",
      "to": "extend",
      "type": "root",
      "note": "ex-（向外）+ tend（伸）→ 往外伸出去 → 延长、扩展"
    },
    {
      "from": "tend",
      "to": "intend",
      "type": "root",
      "note": "in-（朝向）+ tend（伸）→ 心思朝某个方向伸过去 → 打算"
    },
    {
      "from": "tend",
      "to": "pretend",
      "type": "root",
      "note": "pre-（在前）+ tend（伸）→ 在真相前面先伸出一层幌子 → 假装"
    },
    {
      "from": "tend",
      "to": "extensive",
      "type": "root",
      "note": "extend（往外伸）+ -ive（…的）→ 伸得很开的 → 广泛的"
    },
    {
      "from": "tend",
      "to": "intensive",
      "type": "root",
      "note": "in-（朝内、朝一点）+ tens（伸、绷）+ -ive → 力气全绷向一点的 → 密集的"
    },
    {
      "from": "tend",
      "to": "tendency",
      "type": "root",
      "note": "tend（伸）+ -ency（名词）→ 总往某个方向伸的那个劲头 → 倾向"
    },
    {
      "from": "ced",
      "to": "proceed",
      "type": "root",
      "note": "pro-（向前）+ ceed（ced 的变体，行走）→ 继续往前走 → 进行"
    },
    {
      "from": "ced",
      "to": "process",
      "type": "root",
      "note": "pro-（向前）+ cess（ced 的变体，行走）→ 一路往前走过的那串步骤 → 过程"
    },
    {
      "from": "ced",
      "to": "procedure",
      "type": "root",
      "note": "proceed（往前走）+ -ure（名词）→ 规定该怎么往前走的那套步骤 → 程序"
    },
    {
      "from": "ced",
      "to": "success",
      "type": "root",
      "note": "suc-（sub- 的变体，紧接着）+ cess（行走）→ 一步紧接一步走到了终点 → 成功"
    },
    {
      "from": "ced",
      "to": "successor",
      "type": "root",
      "note": "suc-（紧接着）+ cess（行走）+ -or（人）→ 紧接着上一个走上来的人 → 继任者"
    },
    {
      "from": "ced",
      "to": "exceed",
      "type": "root",
      "note": "ex-（出、越过）+ ceed（行走）→ 走出界线之外 → 超过"
    },
    {
      "from": "jac",
      "to": "object",
      "type": "root",
      "note": "ob-（对着、挡在前面）+ ject（扔）→ 被扔到面前挡着的那个东西 → 物体；作动词时是把话扔到对方面前 → 反对"
    },
    {
      "from": "jac",
      "to": "subject",
      "type": "root",
      "note": "sub-（在下）+ ject（扔）→ 被扔到下面、受人摆布的那个 → 臣民；被摊在下面供研究的那个 → 主题"
    },
    {
      "from": "jac",
      "to": "project",
      "type": "root",
      "note": "pro-（向前）+ ject（扔）→ 往前扔出去的那件事 → 计划；把光往前扔到幕布上 → 投影"
    },
    {
      "from": "jac",
      "to": "projector",
      "type": "root",
      "note": "project（往前抛）+ -or（施动器）→ 负责把光往前抛的那个装置 → 投影仪"
    },
    {
      "from": "jac",
      "to": "reject",
      "type": "root",
      "note": "re-（往回）+ ject（扔）→ 把送来的东西扔回去 → 拒绝"
    },
    {
      "from": "jac",
      "to": "inject",
      "type": "root",
      "note": "in-（进入）+ ject（扔）→ 把东西扔进内部 → 注入"
    },
    {
      "from": "jac",
      "to": "objective",
      "type": "root",
      "note": "object（摆在面前的东西）+ -ive（…的）→ 只看摆在面前那个东西本身的 → 客观的；作名词是摆在前面要达成的那"
    },
    {
      "from": "jac",
      "to": "subjective",
      "type": "root",
      "note": "subject（被置于下方的那个，引申为'感受的主体'）+ -ive → 从主体自身感受出发的 → 主观的"
    },
    {
      "from": "pend",
      "to": "depend",
      "type": "root",
      "note": "de-（向下）+ pend（挂）→ 从上面挂下来，全靠那根绳 → 依赖"
    },
    {
      "from": "pend",
      "to": "dependent",
      "type": "root",
      "note": "depend（挂着）+ -ent（…的）→ 挂在别处才立得住的 → 依赖的"
    },
    {
      "from": "pend",
      "to": "suspend",
      "type": "root",
      "note": "sus-（sub- 的变体，在下）+ pend（挂）→ 挂在下面不着地 → 悬挂；引申为让事情停在半空 → 暂停"
    },
    {
      "from": "pend",
      "to": "expend",
      "type": "root",
      "note": "ex-（向外）+ pend（称量）→ 把钱称出来付出去 → 花费"
    },
    {
      "from": "pend",
      "to": "expensive",
      "type": "root",
      "note": "expend（称出去付）+ -ive（…的）→ 要称出很多才付得起的 → 昂贵的"
    },
    {
      "from": "pend",
      "to": "compensate",
      "type": "root",
      "note": "com-（一起、相对）+ pens（称量）+ -ate → 两边一起称，把轻的那头补平 → 补偿"
    },
    {
      "from": "pend",
      "to": "compensation",
      "type": "root",
      "note": "compensate（称平）+ -ation（名词）→ 用来把两边称平的那笔东西 → 补偿金"
    },
    {
      "from": "pars",
      "to": "part",
      "type": "root",
      "note": "pars 本身即词根，无词缀 → 从整体切下来的那一块，或使双方分开"
    },
    {
      "from": "pars",
      "to": "partial",
      "type": "root",
      "note": "part（部分）+ -ial（…的）→ 只涉及一部分的 → 部分的；只偏向一部分人的 → 偏心的"
    },
    {
      "from": "pars",
      "to": "partly",
      "type": "root",
      "note": "part（部分）+ -ly（副词）→ 只在一部分程度上 → 部分地"
    },
    {
      "from": "pars",
      "to": "depart",
      "type": "root",
      "note": "de-（离开）+ part（分开）→ 与此地分开 → 离开"
    },
    {
      "from": "pars",
      "to": "departure",
      "type": "root",
      "note": "depart（分离而去）+ -ure（名词）→ 分离而去这件事 → 启程"
    },
    {
      "from": "pars",
      "to": "department",
      "type": "root",
      "note": "de-（分开）+ part（部分）+ -ment（结果）→ 从整体里划分出来的那一块 → 部门"
    },
    {
      "from": "pars",
      "to": "impart",
      "type": "root",
      "note": "im-（进入）+ part（分出一份）→ 分一份给对方 → 传授"
    },
    {
      "from": "fin",
      "to": "final",
      "type": "root",
      "note": "fin（界限、尽头）+ -al（…的）→ 处在尽头的 → 最后的"
    },
    {
      "from": "fin",
      "to": "finally",
      "type": "root",
      "note": "final（处在尽头的）+ -ly（副词）→ 到了尽头才 → 最终"
    },
    {
      "from": "fin",
      "to": "finish",
      "type": "root",
      "note": "fin（尽头）+ -ish（动词后缀）→ 使到达尽头 → 完成"
    },
    {
      "from": "fin",
      "to": "finite",
      "type": "root",
      "note": "fin（界限）+ -ite（…的）→ 有界限的 → 有限的"
    },
    {
      "from": "fin",
      "to": "infinite",
      "type": "root",
      "note": "in-（否定）+ fin（界限）+ -ite → 没有界限的 → 无限的"
    },
    {
      "from": "fin",
      "to": "definite",
      "type": "root",
      "note": "de-（彻底）+ fin（划界）+ -ite → 界线已彻底划清的 → 明确的"
    },
    {
      "from": "fin",
      "to": "definition",
      "type": "root",
      "note": "de-（彻底）+ fin（划界）+ -ition（名词）→ 把界线划清这件事 → 定义"
    },
    {
      "from": "ag",
      "to": "act",
      "type": "root",
      "note": "ag（驱动）的分词形 act → 使某事动起来，即做；引申为在台上做出来 → 表演；被做成的条文 → 法案"
    },
    {
      "from": "ag",
      "to": "action",
      "type": "root",
      "note": "act（做）+ -ion（名词）→ 做这件事本身，或做出来的过程 → 行动"
    },
    {
      "from": "ag",
      "to": "active",
      "type": "root",
      "note": "act（做）+ -ive（爱…的）→ 一直在动、在做的 → 积极的"
    },
    {
      "from": "ag",
      "to": "actor",
      "type": "root",
      "note": "act（做、表演）+ -or（人）→ 做这个动作的人 → 演员"
    },
    {
      "from": "ag",
      "to": "actual",
      "type": "root",
      "note": "act（做、发生）+ -ual（…的）→ 真的做出来了的 → 实际的"
    },
    {
      "from": "ag",
      "to": "exact",
      "type": "root",
      "note": "ex-（彻底）+ act（做）→ 做到彻底、一分不差 → 精确的"
    },
    {
      "from": "ag",
      "to": "react",
      "type": "root",
      "note": "re-（回、反过来）+ act（做）→ 对着来的东西反过来做一下 → 反应"
    },
    {
      "from": "ag",
      "to": "interact",
      "type": "root",
      "note": "inter-（相互之间）+ act（做）→ 彼此对着做 → 互动"
    },
    {
      "from": "stru",
      "to": "structure",
      "type": "root",
      "note": "struct（堆叠、建造）+ -ure（名词）→ 堆叠起来形成的样子 → 结构"
    },
    {
      "from": "stru",
      "to": "construct",
      "type": "root",
      "note": "con-（一起）+ struct（堆叠）→ 把材料一起垒起来 → 建造"
    },
    {
      "from": "stru",
      "to": "destructive",
      "type": "root",
      "note": "de-（反向、拆除）+ struct（堆叠）+ -ive → 把垒好的拆掉的 → 破坏性的"
    },
    {
      "from": "stru",
      "to": "instruct",
      "type": "root",
      "note": "in-（进入）+ struct（堆叠）→ 在对方脑中一层层垒起知识 → 教导；也指下达要照办的条目 → 指示"
    },
    {
      "from": "stru",
      "to": "instrument",
      "type": "root",
      "note": "in-（进入）+ stru（堆叠、装配）+ -ment（物）→ 装配起来用于做事的那件东西 → 器具"
    },
    {
      "from": "stru",
      "to": "instrumental",
      "type": "root",
      "note": "instrument（器具）+ -al（…的）→ 起了器具作用的 → 起关键作用的"
    },
    {
      "from": "dict",
      "to": "predict",
      "type": "root",
      "note": "pre-（在…之前）+ dict（说）→ 事情发生前先说出来 → 预言"
    },
    {
      "from": "dict",
      "to": "contradict",
      "type": "root",
      "note": "contra-（相反）+ dict（说）→ 说反过来的话 → 反驳；两说相互对立 → 矛盾"
    },
    {
      "from": "dict",
      "to": "dictate",
      "type": "root",
      "note": "dict（说）+ -ate（动词）→ 反复说出来让人照记 → 口述；说了对方就得照办 → 命令"
    },
    {
      "from": "dict",
      "to": "dictation",
      "type": "root",
      "note": "dictate（口述）+ -ion（名词）→ 口述这件事，或据此写下的练习 → 听写"
    },
    {
      "from": "dict",
      "to": "addict",
      "type": "root",
      "note": "ad-（朝向）+ dict（说、判给）→ 罗马法中被判归某人所有 → 离不开某物的人"
    },
    {
      "from": "sci",
      "to": "science",
      "type": "root",
      "note": "sci（知道、分辨）+ -ence（名词）→ 分辨得清的那套知识 → 科学"
    },
    {
      "from": "sci",
      "to": "scientist",
      "type": "root",
      "note": "science（分辨得清的知识）+ -ist（人）→ 从事这套知识的人 → 科学家"
    },
    {
      "from": "sci",
      "to": "conscious",
      "type": "root",
      "note": "con-（一起、共同）+ sci（知道）→ 心里同时知道着 → 有意识的"
    },
    {
      "from": "sci",
      "to": "conscience",
      "type": "root",
      "note": "con-（一起）+ sci（知道）+ -ence（名词）→ 心里同时知道对错的那份感觉 → 良心"
    },
    {
      "from": "sci",
      "to": "conscientious",
      "type": "root",
      "note": "conscience（心里知对错）+ -ous（…的）→ 事事按那份分辨来做的 → 尽责的"
    },
    {
      "from": "crit",
      "to": "critic",
      "type": "root",
      "note": "crit（判别）+ -ic（人）→ 做判别的人 → 评论家"
    },
    {
      "from": "crit",
      "to": "critical",
      "type": "root",
      "note": "crit（判别）+ -al（…的）→ 挑出问题的 → 批评的；也指到了必须判断的关口 → 关键的"
    },
    {
      "from": "crit",
      "to": "criticism",
      "type": "root",
      "note": "critic（判别者）+ -ism（行为）→ 做判别这件事，及说出的话 → 批评"
    },
    {
      "from": "crit",
      "to": "criticize",
      "type": "root",
      "note": "critic（判别者）+ -ize（使动）→ 去做判别、指出不足 → 批评"
    },
    {
      "from": "crit",
      "to": "criterion",
      "type": "root",
      "note": "crit（判别）+ -erion（工具、依据）→ 用来判别的那把尺 → 标准"
    }
  ]
}
